(- destination_availability_locked destination_availability_alpha: true (step 15 set locked, step 16 kept locked))
(- destination_node_occupied destination_node_alpha: true (step 15 set occupied, step 16 didn't change))
(- destination_node_ready destination_node_alpha: true (step 13 set ready, step 16 set ready again))
(- dispatch_slot_available dispatch_slot_alpha: true (step 1 effect))
(- dispatched shift_candidate_alpha: true (step 1 effect))
(- origin_availability_confirmed origin_availability_alpha: true (step 7 set confirmed))
(- origin_availability_locked origin_availability_alpha: true (step 6 set locked, step 7 kept locked))
(- origin_node_occupied origin_node_alpha: true (step 6 set occupied, step 7 didn't change))
(- origin_node_ready origin_node_alpha: true (step 4 set ready, step 7 kept ready))
(- transport_leg_assembled transport_leg_alpha: true (step 19))
(- transport_leg_destination_linked transport_leg_alpha destination_node_alpha: true (step 19))
(- transport_leg_origin_linked transport_leg_alpha origin_node_alpha: true (step 19))
(- vehicle_allocated destination_availability_alpha: true (step 10))
(- vehicle_available vehicle_unit_gamma: true (step 1 effect))
(All goal satisfied.)
(Now we need to ensure we didn't violate any preconditions we missed.)
(Let's verify each action's preconditions in order.)
(Initial state as given.)
(Action 1: execute_schedule_dispatch shift_candidate_alpha vehicle_unit_gamma dispatch_slot_alpha)
(Preconditions:)
(- dispatch_allocated ?candidate: shift_candidate_alpha dispatch_allocated true (init))
(- candidate_vehicle_linked ?candidate ?vehicle_unit: shift_candidate_alpha vehicle_unit_gamma true (init))
(- candidate_dispatch_slot_linked ?candidate ?dispatch_slot: shift_candidate_alpha dispatch_slot_alpha true (init))
(- not dispatched ?candidate: dispatched shift_candidate_alpha false (init))
(All good.)
(Effects: dispatched true, vehicle_available vehicle_unit_gamma true, dispatch_slot_available dispatch_slot_alpha true.)
(Now state after action1: we have dispatched true, vehicle_available gamma true, dispatch_slot_available true.)
(Also note: vehicle_allocated shift_candidate_alpha remains true (not changed). candidate_vehicle_linked shift_candidate_alpha vehicle_unit_gamma remains true.)
(Action2: attach_task_profile origin_availability_alpha route_task_profile_alpha)
(Preconditions:)
(- candidate_created origin_availability_alpha: true (init))
(- vehicle_allocated origin_availability_alpha: true (init))
(- route_task_profile_available route_task_profile_alpha: true (init) (still true because we haven't used it))
(Effects: candidate_task_profile_linked origin_availability_alpha route_task_profile_alpha true, route_task_profile_available false.)
(Now state: origin task profile linked, profile unavailable.)
(Action3: confirm_candidate_preparedness origin_availability_alpha route_task_profile_alpha)
(Preconditions:)
(- candidate_created origin_availability_alpha: true)
(- vehicle_allocated origin_availability_alpha: true)
(- candidate_task_profile_linked origin_availability_alpha route_task_profile_alpha: true (just set))
(- not candidate_prepared origin_availability_alpha: initially false (not prepared) -> true)
(Effect: candidate_prepared origin_availability_alpha true.)
(Now state: origin prepared.)
(Action4: activate_origin_node origin_availability_alpha origin_node_alpha route_task_profile_alpha)
(Preconditions:)
(- candidate_prepared origin_availability_alpha: true)
(- candidate_task_profile_linked origin_availability_alpha route_task_profile_alpha: true)
(- origin_availability_node_linked origin_availability_alpha origin_node_alpha: true (init))
(- not origin_node_ready origin_node_alpha: initially false (not ready) -> true)
(- not origin_node_occupied origin_node_alpha: initially false -> true)
(Effect: origin_node_ready origin_node_alpha true.)
(Now state: origin_node_ready true.)
(Action5: assign_operator_resource origin_availability_alpha driver_operator_alpha)
(Preconditions:)
(- candidate_prepared origin_availability_alpha: true)
(- operator_available driver_operator_alpha: initially true, still true (we haven't used operator yet))
(Effect: candidate_operator_linked origin_availability_alpha driver_operator_alpha true, operator_available driver_operator_alpha false.)
(Now state: origin operator linked, operator unavailable.)
(Action6: load_origin_payload origin_availability_alpha origin_node_alpha cargo_payload_alpha)
(Preconditions:)
(- candidate_prepared origin_availability_alpha: true)
(- origin_availability_node_linked origin_availability_alpha origin_node_alpha: true)
(- cargo_available cargo_payload_alpha: true (init, still true))
(- not origin_availability_locked origin_availability_alpha: currently false (we haven't locked) -> true)
(Effect:)
(- origin_node_occupied origin_node_alpha true)
(- origin_availability_locked origin_availability_alpha true)
(- origin_payload_linked origin_availability_alpha cargo_payload_alpha true)
(- cargo_available cargo_payload_alpha false)
(Now state: origin node occupied, availability locked, payload linked, cargo unavailable.)
(Action7: unload_origin_payload origin_availability_alpha origin_node_alpha route_task_profile_alpha cargo_payload_alpha)
(Preconditions:)
(- candidate_prepared origin_availability_alpha: true)
(- candidate_task_profile_linked origin_availability_alpha route_task_profile_alpha: true (still linked))
(- origin_availability_node_linked origin_availability_alpha origin_node_alpha: true)
(- origin_node_occupied origin_node_alpha: true (just set))
(- origin_payload_linked origin_availability_alpha cargo_payload_alpha: true (just set))
(- not origin_availability_confirmed origin_availability_alpha: currently false (we have locked but not confirmed) -> true)
(Effect:)
(- origin_node_ready origin_node_alpha true (already true))
(- origin_availability_confirmed origin_availability_alpha true)
(- cargo_available cargo_payload_alpha true)
(- not origin_payload_linked origin_availability_alpha cargo_payload_alpha (so link removed))
(Now state: origin node ready (still), occupied (still), availability locked true, confirmed true, cargo available true, payload link false.)
(Action8: release_operator_resource origin_availability_alpha driver_operator_alpha)
(Precondition: candidate_operator_linked origin_availability_alpha driver_operator_alpha: true (from step5))
(Effect: operator_available driver_operator_alpha true, not candidate_operator_linked origin_availability_alpha driver_operator_alpha.)
(Now state: operator available again, origin operator link removed.)
(Action9: detach_task_profile origin_availability_alpha route_task_profile_alpha)
(Precondition: candidate_task_profile_linked origin_availability_alpha route_task_profile_alpha: true (still linked))
(Effect: route_task_profile_available route_task_profile_alpha true, not candidate_task_profile_linked origin_availability_alpha route_task_profile_alpha.)
(Now state: profile available, origin task profile link removed.)
(Now origin still prepared, node ready/occupied/locked/confirmed, etc.)
(Action10: allocate_vehicle_unit destination_availability_alpha vehicle_unit_beta)
(Preconditions:)
(- candidate_created destination_availability_alpha: true (init))
(- not vehicle_allocated destination_availability_alpha: initially false (we haven't allocated) -> true)
(- vehicle_available vehicle_unit_beta: true (init, still true) -> yes)
(Effect:)
(- vehicle_allocated destination_availability_alpha true)
(- candidate_vehicle_linked destination_availability_alpha vehicle_unit_beta true)
(- not vehicle_available vehicle_unit_beta (so vehicle_unit_beta becomes unavailable))
(Now state: destination vehicle allocated and linked, vehicle_unit_beta unavailable.)
(Action11: attach_task_profile destination_availability_alpha route_task_profile_alpha)
(Preconditions:)
(- candidate_created destination_availability_alpha: true)
(- vehicle_allocated destination_availability_alpha: true (just set))
(- route_task_profile_available route_task_profile_alpha: true (we made available in step9))
(Effect:)
(- candidate_task_profile_linked destination_availability_alpha route_task_profile_alpha true)
(- route_task_profile_available route_task_profile_alpha false)
(Now state: destination task profile linked, profile unavailable.)
(Action12: confirm_candidate_preparedness destination_availability_alpha route_task_profile_alpha)
(Preconditions:)
(- candidate_created destination_availability_alpha: true)
(- vehicle_allocated destination_availability_alpha: true)
(- candidate_task_profile_linked destination_availability_alpha route_task_profile_alpha: true)
(- not candidate_prepared destination_availability_alpha: initially false -> true)
(Effect: candidate_prepared destination_availability_alpha true.)
(Now state: destination prepared.)
(Action13: activate_destination_node destination_availability_alpha destination_node_alpha route_task_profile_alpha)
(Preconditions:)
(- candidate_prepared destination_availability_alpha: true)
(- candidate_task_profile_linked destination_availability_alpha route_task_profile_alpha: true)
(- destination_availability_node_linked destination_availability_alpha destination_node_alpha: true (init))
(- not destination_node_ready destination_node_alpha: initially false -> true)
(- not destination_node_occupied destination_node_alpha: initially false -> true)
(Effect: destination_node_ready destination_node_alpha true.)
(Now state: destination node ready.)
(Action14: assign_operator_resource destination_availability_alpha driver_operator_alpha)
(Preconditions:)
(- candidate_prepared destination_availability_alpha: true)
(- operator_available driver_operator_alpha: true (we released from origin in step8))
(Effect: candidate_operator_linked destination_availability_alpha driver_operator_alpha true, operator_available driver_operator_alpha false.)
(Now state: destination operator linked, operator unavailable.)
(Action15: load_destination_payload destination_availability_alpha destination_node_alpha cargo_payload_alpha)
(Preconditions:)
(- candidate_prepared destination_availability_alpha: true)
(- destination_availability_node_linked destination_availability_alpha destination_node_alpha: true)
(- cargo_available cargo_payload_alpha: true (we have cargo available after origin unload)
