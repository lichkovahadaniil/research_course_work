(Preconditions: candidate_prepared destination_availability_alpha (true), destination_availability_node_linked destination_availability_alpha destination_node_alpha (true), cargo_available cargo_payload_alpha (true after origin unload), not destination_availability_locked destination_availability_alpha (true initially).)
(Effect: destination_node_occupied destination_node_alpha, destination_availability_locked destination_availability_alpha, destination_payload_linked destination_availability_alpha cargo_payload_alpha, not cargo_available cargo_payload_alpha.)
(12. Unload destination payload:)
(unload_destination_payload destination_availability_alpha destination_node_alpha route_task_profile_alpha cargo_payload_alpha)
(Preconditions: candidate_prepared destination_availability_alpha (true), candidate_task_profile_linked destination_availability_alpha route_task_profile_alpha (true), destination_availability_node_linked destination_availability_alpha destination_node_alpha (true), destination_node_occupied destination_node_alpha (true from load), destination_payload_linked destination_availability_alpha cargo_payload_alpha (true), not destination_availability_confirmed destination_availability_alpha (true).)
(Effect: destination_node_ready destination_node_alpha (still true), destination_availability_confirmed destination_availability_alpha, cargo_available cargo_payload_alpha, not destination_payload_linked destination_availability_alpha cargo_payload_alpha.)
(Note: destination_availability_locked remains true.)
(Now after these, destination node ready & occupied, destination availability locked & confirmed, cargo available.)
