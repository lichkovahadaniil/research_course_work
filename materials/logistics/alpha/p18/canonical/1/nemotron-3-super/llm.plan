- equipment_resource_alpha, equipment_resource_beta
- service_window_alpha, service_window_beta
- dispatch_slot_alpha
- driver_operator_alpha
- skill_certificate_alpha
- compliance_certificate_alpha
- operational_constraint_alpha, operational_constraint_beta
- transport_leg_alpha
- origin_node_alpha
- destination_node_alpha

