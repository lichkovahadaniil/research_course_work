(45. finalize_candidate_after_compliance_validation scA   (dispatch_ready scA))
(46. allocate_dispatch_slot_for_candidate scA ds rtp)
(47. execute_schedule_dispatch scA vu_gamma ds)
(48. release_operator_resource scA op)
(49. detach_task_profile scA rtp)
(Now scB:)
(50. create_candidate scB)
(51. allocate_vehicle_unit scB vu_alpha   (vu_alpha free after oa dispatch))
(52. attach_task_profile scB rtp)
(53. confirm_candidate_preparedness scB rtp)
