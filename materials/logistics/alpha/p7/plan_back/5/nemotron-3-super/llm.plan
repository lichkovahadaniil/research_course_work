B4: confirm_candidate_preparedness destination_availability_alpha route_task_profile_alpha
B5: assign_operator_resource destination_availability_alpha driver_operator_alpha
B6: activate_destination_node destination_availability_alpha destination_node_alpha route_task_profile_alpha
B7: lock_destination_availability destination_availability_alpha destination_node_alpha driver_operator_alpha

