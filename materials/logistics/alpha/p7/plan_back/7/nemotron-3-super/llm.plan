   (allocate_vehicle_unit destination_availability_alpha vehicle_unit_beta)

8. attach_task_profile destination_availability_alpha route_task_profile_alpha
   (attach_task_profile destination_availability_alpha route_task_profile_alpha)

9. confirm_candidate_preparedness destination_availability_alpha route_task_profile_alpha
   (confirm_candidate_preparedness destination_availability_alpha route_task_profile_alpha)

10. assign_operator_resource destination_availability_alpha driver_operator_alpha
    (assign_operator_resource destination_availability_alpha driver_operator_alpha)

11. lock_destination_availability destination_availability_alpha destination_node_alpha driver_operator_alpha
    (lock_destination_availability destination_availability_alpha destination_node_alpha driver_operator_alpha)

12. release_operator_resource destination_availability_alpha driver_operator_alpha
    (release_operator_resource destination_availability_alpha driver_operator_alpha)

Now assemble leg:

13. assemble_transport_leg origin_availability_alpha destination_availability_alpha origin_node_alpha destination_node_alpha transport_leg_alpha
    (assemble_transport_leg origin_availability_alpha destination_availability_alpha origin_node_alpha destination_node_alpha transport_leg_alpha)

Preconditions: origin_availability_locked origin_availability_alpha (true after step5), destination_availability_locked destination_availability_alpha (true after step11), origin_availability_node_linked origin_availability_alpha origin_node_alpha (true), destination_availability_node_linked destination_availability_alpha destination_node_alpha (true), origin_node_ready origin_node_alpha (true), destination_node_ready destination_node_alpha (true), origin_availability_confirmed origin_availability_alpha (true after step5), destination_availability_confirmed destination_availability_alpha (true after step11), transport_leg_available transport_leg_alpha (true init).

Effect: transport_leg_assembled transport_leg_alpha, transport_leg_origin_linked transport_leg_alpha origin_node_alpha, transport_leg_destination_linked transport_leg_alpha destination_node_alpha, not transport_leg_available transport_leg_alpha.

Now authorize loading:

