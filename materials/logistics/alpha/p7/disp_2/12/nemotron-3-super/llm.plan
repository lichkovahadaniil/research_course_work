(Now we need to produce the plan lines.)
(We'll need to write each action line with proper arguments.)
(Let's define naming:)
(- create_candidate ?candidate)
(- allocate_vehicle_unit ?candidate ?vehicle_unit)
(- attach_task_profile ?candidate ?route_task_profile)
(- confirm_candidate_preparedness ?candidate ?route_task_profile)
(- assign_operator_resource ?candidate ?operator_resource)
(- assign_skill_certificate ?candidate ?skill_certificate)
(- assign_compliance_certificate ?candidate ?compliance_certificate)
(- load_container_onto_leg ?candidate ?loading_container ?transport_leg)
(- stage_schedule_candidate ?candidate ?loading_container ?transport_leg ?route_task_profile)
(- verify_loading_profile_nominal ?candidate ?skill_certificate ?operator_resource ?loading_container ?transport_leg)
(- release_operator_resource ?candidate ?operator_resource)
(- establish_clearance_nominal ?candidate ?compliance_certificate ?loading_container ?transport_leg)
(- finalize_candidate_direct ?candidate)
(- allocate_dispatch_slot_for_candidate ?candidate ?dispatch_slot ?route_task_profile)
(- execute_schedule_dispatch ?candidate ?vehicle_unit ?dispatch_slot)
(- detach_task_profile ?candidate ?route_task_profile)
(- create_candidate for origin/destination same.)
(- activate_origin_node ?origin_availability ?origin_node ?route_task_profile)
(- lock_origin_availability ?origin_availability ?origin_node ?operator_resource)
(- release_operator_resource (same as above))
(- mark_origin_availability_dispatch_ready ?origin_availability ?transport_leg)
(- allocate_dispatch_slot_for_candidate (same action works for origin/destination as they are candidate_entity))
(- execute_origin_dispatch ?origin_availability ?vehicle_unit ?dispatch_slot)
(- similarly for destination: activate_destination_node, lock_destination_availability, mark_destination_availability_dispatch_ready, allocate_dispatch_slot_for_candidate, execute_destination_dispatch.)
(Now we need to include the correct arguments.)
(Let's list objects:)
(- origin_availability_alpha)
(- destination_availability_alpha)
(- shift_candidate_alpha)
(- shift_candidate_beta)
(- vehicle_unit_alpha)
(- vehicle_unit_beta)
(- vehicle_unit_gamma)
(- route_task_profile_alpha)
(- driver_operator_alpha)
(- cargo_payload_alpha (not used))
(- origin_node_alpha)
(- destination_node_alpha)
(- transport_leg_alpha)
(- loading_container_alpha)
(- loading_container_beta)
(- equipment_resource_alpha)
(- equipment_resource_beta)
(- service_window_alpha)
(- service_window_beta)
(- dispatch_slot_alpha)
(- skill_certificate_alpha)
(- operational_constraint_alpha)
(- operational_constraint_beta)
(- compliance_certificate_alpha)
(We'll not use cargo, service windows, operational constraints.)
(Now we need to produce plan.)
(We'll start with origin preparation.)
(Step 1: create_candidate origin_availability_alpha)
(Step 2: allocate_vehicle_unit origin_availability_alpha vehicle_unit_alpha)
(Step 3: attach_task_profile origin_availability_alpha route_task_profile_alpha)
(Step 4: confirm_candidate_preparedness origin_availability_alpha route_task_profile_alpha)
(Step 5: assign_operator_resource origin_availability_alpha driver_operator_alpha)
(Step 6: activate_origin_node origin_availability_alpha origin_node_alpha route_task_profile_alpha)
(Step 7: lock_origin_availability origin_availability_alpha origin_node_alpha driver_operator_alpha)
(Step 8: release_operator_resource origin_availability_alpha driver_operator_alpha)
(Step 9: detach_task_profile origin_availability_alpha route_task_profile_alpha (to free profile for destination))
(Now destination:)
(Step10: create_candidate destination_availability_alpha)
(Step11: allocate_vehicle_unit destination_availability_alpha vehicle_unit_beta)
(Step12: attach_task_profile destination_availability_alpha route_task_profile_alpha)
(Step13: confirm_candidate_preparedness destination_availability_alpha route_task_profile_alpha)
(Step14: assign_operator_resource destination_availability_alpha driver_operator_alpha)
(Step15: activate_destination_node destination_availability_alpha destination_node_alpha route_task_profile_alpha)
(Step16: lock_destination_availability destination_availability_alpha destination_node_alpha driver_operator_alpha)
(Step17: release_operator_resource destination_availability_alpha driver_operator_alpha)
(Step18: detach_task_profile destination_availability_alpha route_task_profile_alpha)
(Now we have origin and destination locked.)
(Now assemble transport leg:)
(Step19: assemble_transport_leg origin_availability_alpha destination_availability_alpha origin_node_alpha destination_node_alpha transport_leg_alpha)
(Now authorize loading:)
(Step20: authorize_transport_leg_loading transport_leg_alpha origin_availability_alpha route_task_profile_alpha)
(Now we have leg assembled and loading authorized.)
(Now mark origin dispatch ready:)
(Step21: mark_origin_availability_dispatch_ready origin_availability_alpha transport_leg_alpha)
(Now mark destination dispatch ready:)
(Step22: mark_destination_availability_dispatch_ready destination_availability_alpha transport_)
