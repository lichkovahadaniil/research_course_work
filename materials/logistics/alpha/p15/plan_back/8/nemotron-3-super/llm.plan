Dispatch_allocated requires allocate_dispatch_slot_for_candidate action: precondition dispatch_ready ?candidate, candidate_task_profile_linked ?candidate ?route_task_profile, dispatch_slot_available ?dispatch_slot, not dispatch_allocated ?candidate. Effect: dispatch_allocated true, candidate_dispatch_slot_linked true, not dispatch_slot_available.

