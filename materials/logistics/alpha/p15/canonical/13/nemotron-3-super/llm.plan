(Important delete effects:)
(- allocate_vehicle_unit: deletes vehicle_available ?vehicle_unit.)
(- attach_task_profile: deletes route_task_profile_available ?route_task_profile.)
(- confirm_candidate_preparedness: no deletes.)
(- detach_task_profile: deletes candidate_task_profile_linked, adds route_task_profile_available.)
(- assign_operator_resource: deletes operator_available.)
(- release_operator_resource: adds operator_available, deletes candidate_operator_linked.)
(- assign_skill_certificate: deletes skill_certificate_available.)
(- release_skill_certificate: adds skill_certificate_available, deletes candidate_skill_certificate_linked.)
(- assign_compliance_certificate: deletes compliance_certificate_available.)
(- release_compliance_certificate: adds compliance_certificate_available, deletes candidate_compliance_certificate_linked.)
(- activate_origin_node: no deletes (precondition includes not origin_node_ready and not origin_node_occupied; effect adds origin_node_ready). No deletes.)
(- lock_origin_availability: no deletes (adds origin_availability_locked, origin_availability_confirmed).)
(- load_origin_payload: deletes cargo_available, adds origin_node_occupied, origin_availability_locked, origin_payload_linked.)
(- unload_origin_payload: deletes origin_payload_linked, adds origin_node_ready, origin_availability_confirmed, cargo_available.)
(- activate_destination)
