(- origin_availability_confirmed origin_availability_alpha true)
(- cargo_available cargo_payload_alpha true (cargo becomes available again))
(- not origin_payload_linked origin_availability_alpha cargo_payload_alpha)
(Now we have:)
(- origin_node_occupied true (still))
(- origin_node_ready true)
(- origin_availability_locked true)
(- origin_availability_confirmed true)
(- cargo_available true)
