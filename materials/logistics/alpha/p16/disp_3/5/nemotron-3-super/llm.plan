21. verify_loading_profile_destination_flag shift_candidate_beta skill_certificate_alpha driver_operator_alpha loading_container_beta transport_leg_alpha
22. establish_clearance_destination_loaded shift_candidate_beta compliance_certificate_alpha loading_container_beta transport_leg_alpha
