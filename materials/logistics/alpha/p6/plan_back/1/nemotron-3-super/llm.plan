Now let's detail each action with parameters.

We'll need to ensure we have the right types.

Action definitions:

create_candidate ?candidate - candidate_entity
effect: candidate_created ?candidate

allocate_vehicle_unit ?candidate - candidate_entity ?vehicle_unit - vehicle_unit
pre: candidate_created ?candidate, not vehicle_allocated ?candidate, vehicle_available ?vehicle_unit
eff: vehicle_allocated ?candidate, candidate_vehicle_linked ?candidate ?vehicle_unit, not vehicle_available ?vehicle_unit

attach_task_profile ?candidate - candidate_entity ?route_task_profile - route_task_profile
pre: candidate_created ?candidate, vehicle_allocated ?candidate, route_task_profile_available ?route_task_profile
eff: candidate_task_profile_linked ?candidate ?route_task_profile, not route_task_profile_available ?route_task_profile

confirm_candidate_preparedness ?candidate - candidate_entity ?route_task_profile - route_task_profile
pre: candidate_created ?candidate, vehicle_allocated ?candidate, candidate_task_profile_linked ?candidate ?route_task_profile, not candidate_prepared ?candidate
eff: candidate_prepared ?candidate

assign_operator_resource ?candidate - candidate_entity ?operator_resource - operator_resource
pre: candidate_prepared ?candidate, operator_available ?operator_resource
eff: candidate_operator_linked ?candidate ?operator_resource, not operator_available ?operator_resource

assign_skill_certificate ?candidate - schedule_candidate ?skill_certificate - skill_certificate
pre: candidate_prepared ?candidate, skill_certificate_available ?skill_certificate
eff: candidate_skill_certificate_linked ?candidate ?skill_certificate, not skill_certificate_available ?skill_certificate

assign_compliance_certificate ?candidate - schedule_candidate ?compliance_certificate - compliance_certificate
pre: candidate_prepared ?candidate, compliance_certificate_available ?compliance_certificate
eff: candidate_compliance_certificate_linked ?candidate ?compliance_certificate, not compliance_certificate_available ?compliance_certificate

load_container_onto_leg ?candidate - schedule_candidate ?loading_container - loading_container ?transport_leg - transport_leg
pre: candidate_prepared ?candidate, candidate_transport_leg_linked ?candidate ?transport_leg, candidate_loading_container_linked ?candidate ?loading_container, loading_container_available ?loading_container, transport_leg_assembled ?transport_leg, transport_leg_loading_authorized ?transport_leg, not loading_container_loaded ?loading_container
eff: loading_container_loaded ?loading_container, loading_container_leg_linked ?loading_container ?transport_leg, not loading_container_available ?loading_container

stage_schedule_candidate ?candidate - schedule_candidate ?loading_container - loading_container ?transport_leg - transport_leg ?route_task_profile - route_task_profile
pre: candidate_prepared ?candidate, candidate_loading_container_linked ?candidate ?loading_container, loading_container_loaded ?loading_container, loading_container_leg_linked ?loading_container ?transport_leg, candidate_task_profile_linked ?candidate ?route_task_profile, not origin_leg_loaded ?transport_leg, not candidate_staged_for_loading ?candidate
eff: candidate_staged_for_loading ?candidate

verify_loading_profile_nominal ?candidate - schedule_candidate ?skill_certificate - skill_certificate ?operator_resource - operator_resource ?loading_container - loading_container ?transport_leg - transport_leg
pre: candidate_staged_for_loading ?candidate, candidate_skill_certificate_linked ?candidate ?skill_certificate, candidate_operator_linked ?candidate ?operator_resource, candidate_loading_container_linked ?candidate ?loading_container, loading_container_leg_linked ?loading_container ?transport_leg, not destination_leg_loaded ?transport_leg, not candidate_loading_verified ?candidate
eff: candidate_loading_verified ?candidate

establish_clearance_nominal ?candidate - schedule_candidate ?compliance_certificate - compliance_certificate ?loading_container - loading_container ?transport_leg - transport_leg
