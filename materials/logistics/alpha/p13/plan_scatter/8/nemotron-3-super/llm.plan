- assemble_fully_loaded_leg: effect (transport_leg_assembled ...) (transport_leg_origin_linked ...) (transport_leg_destination_linked ...) (origin_leg_loaded ...) (destination_leg_loaded ...) (not (transport_leg_available ...)).
- release_compliance_certificate: effect (compliance_certificate_available ...) (not (candidate_compliance_certificate_linked ...)).
- load_container_onto_leg: effect (loading_container_loaded ...) (loading_container_leg_linked ...) (not (loading_container_available ...)).
- stage_schedule_candidate: effect (candidate_staged_for_loading ?candidate).
- assemble_transport_leg: effect (transport_leg_assembled ...) (transport_leg_origin_linked ...) (transport_leg_destination_linked ...) (not (transport_leg_available ...)).
- reserve_equipment_resource: effect (equipment_reserved ?candidate) (candidate_equipment_linked ?candidate ?equipment_resource) (not (equipment_available ?equipment_resource)).
- confirm_equipment_assignment: effect (candidate_staged_for_loading ?candidate) (equipment_confirmed ?candidate).
- unload_origin_payload: effect (origin_node_ready ?origin_node) (origin_availability_confirmed ?origin_availability) (cargo_available ?payload_unit) (not (origin_payload_linked ?origin_availability ?payload_unit)).
- verify_loading_profile_nominal: effect (candidate_loading_verified ?candidate).
- verify_loading_profile_destination_flag: effect (candidate_loading_verified ?candidate).
- load_origin_payload: effect (origin_node_occupied ?origin_node) (origin_availability_locked ?origin_availability) (origin_payload_linked ?origin_availability ?payload_unit) (not (cargo_available ?payload_unit)).
- establish_clearance_nominal: effect (candidate_clearance_established ?candidate).
- establish_clearance_origin_loaded: effect (candidate_clearance_established ?candidate) (route_sequence_context_set ?candidate).
- establish_clearance_destination_loaded: effect (candidate_clearance_established ?candidate) (route_sequence_context_set ?candidate).
- confirm_candidate_preparedness: effect (candidate_prepared ?candidate).
- establish_clearance_full_load: effect (candidate_clearance_established ?candidate) (route_sequence_context_set ?candidate).
- finalize_candidate_direct: effect (candidate_finalized ?candidate) (dispatch_ready ?candidate).
- attach_task_profile: effect (candidate_task_profile_linked ?candidate ?route_task_profile) (not (route_task_profile_available ?route_task_profile)).
- attach_service_window: effect (candidate_service_window_linked ?candidate ?service_window) (not (service_window_available ?service_window)).
- validate_route_sequence: effect (route_sequence_validated ?candidate).
- detach_task_profile: effect (route_task_profile_available ?route_task_profile) (not (candidate_task_profile_linked ?candidate ?route_task_profile)).
- finalize_candidate_after_sequence_validation: effect (candidate_finalized ?candidate) (dispatch_ready ?candidate).
- apply_operational_constraint: effect (constraint_applied ?candidate) (not (operational_constraint_available ?operational_constraint)).
- unload_destination_payload: effect (destination_node_ready ?destination_node) (destination_availability_confirmed ?destination_availability) (cargo_available ?payload_unit) (not (destination_payload_linked ?destination_availability ?payload_unit)).
- confirm_operator_alignment: effect (operator_alignment_confirmed ?candidate).
- verify_compliance_certificate: effect (compliance_validation_complete ?candidate).
- finalize_candidate_after_compliance_validation: effect (candidate_finalized ?candidate) (dispatch_ready ?candidate).
- load_destination_payload: effect (destination_node_occupied ?destination_node) (destination_availability_locked ?destination_availability) (destination_payload_linked ?destination_availability ?payload_unit) (not (cargo_available ?payload_unit)).
- execute_origin_dispatch: effect (dispatched ?origin_availability) (vehicle_available ?vehicle_unit) (dispatch_slot_available ?dispatch_slot).
- release_operator_resource: already.
- release_skill_certificate: already.
- release_compliance_certificate: already.
- execute_destination_dispatch: effect (dispatched ?destination_availability) (vehicle_available ?vehicle_unit) (dispatch_slot_available ?dispatch_slot).
- execute_schedule_dispatch: effect (dispatched ?candidate) (vehicle_available ?vehicle_unit) (dispatch_slot_available ?dispatch_slot).

