(Action list:)
(1. release_compliance_certificate shift_candidate_alpha compliance_certificate_alpha)
(Precondition: candidate_compliance_certificate_linked shift_candidate_alpha compliance_certificate_alpha (true). Effect: compliance_certificate_available, not linked.)
(Now compliance_certificate_alpha available.)
(2. detach_task_profile destination_availability_alpha route_task_profile_alpha)
(Precondition: candidate_task_profile_linked destination_availability_alpha route_task_profile_alpha (true). Effect: route_task_profile_available, not linked.)
(Now profile available.)
(3. attach_task_profile origin_availability_alpha route_task_profile_alpha)
(Precondition: candidate_created origin_availability_alpha (true), vehicle_allocated origin_availability_alpha (true), route_task_profile_available (true). Effect: candidate_task_profile_linked origin_availability_alpha route_task_profile_alpha, not route_task_profile_available.)
(Now origin has profile linked.)
(4. confirm_candidate_preparedness origin_availability_alpha route_task_profile_alpha)
(Precondition: candidate_created origin_availability_alpha (true), vehicle_allocated origin_availability_alpha (true), candidate_task_profile_linked origin_availability_alpha route_task_profile_alpha (true), not candidate_prepared origin_availability_alpha (true). Effect: candidate_prepared origin_availability_alpha true.)
(Now origin prepared.)
(5. activate_origin_node origin_availability_alpha origin_node_alpha route_task_profile_alpha)
(Precondition: candidate_prepared origin_availability_alpha (true), candidate_task_profile_linked origin_availability_alpha route_task_profile_alpha (true), origin_availability_node_linked origin_availability_alpha origin_node_alpha (true), not origin_node_ready origin_node_alpha (true), not origin_node_occupied origin_node_alpha (true). Effect: origin_node_ready origin_node_alpha true.)
(6. load_origin_payload origin_availability_alpha origin_node_alpha cargo_payload_alpha)
(Precondition: candidate_prepared origin_availability_alpha (true), origin_availability_node_linked origin_availability_alpha origin_node_alpha (true), cargo_available cargo_payload_alpha (true), not origin_availability_locked origin_availability_alpha (true). Effect: origin_node_occupied origin_node_alpha true, origin_availability_locked origin_availability_alpha true, origin_payload_linked origin_availability_alpha cargo_payload_alpha true, not cargo_available cargo_payload_alpha.)
(Now cargo unavailable.)
(7. unload_origin_payload origin_availability_alpha origin_node_alpha route_task_profile_alpha cargo_payload_alpha)
(Precondition: candidate_prepared origin_availability_alpha (true), candidate_task_profile_linked origin_availability_alpha route_task_profile_alpha (true), origin_availability_node_linked origin_availability_alpha origin_node_alpha (true), origin_node_occupied origin_node_alpha (true), origin_payload_linked origin_availability_alpha cargo_payload_alpha true, not origin_availability_confirmed origin_availability_alpha (true). Effect: origin_node_ready origin_node_alpha true, origin_availability_confirmed origin_availability_alpha true, cargo_available cargo_payload_alpha true, not origin_payload_linked origin_availability_alpha cargo_payload_alpha.)
(Now origin_node_ready true, origin_availability_confirmed true, cargo available again, origin_payload_linked false, origin_availability_locked remains true (unchanged), origin_node_occupied remains true (unchanged). Good.)
(Now we have origin processed.)
(8. detach_task_profile origin_availability_alpha route_task_profile_alpha)
(Precondition: candidate_task_profile_linked origin_availability_alpha route_task_profile_alpha (true). Effect: route_task_profile_available, not linked.)
(Now profile available.)
(9. attach_task_profile destination_availability_alpha route_task_profile_alpha)
(Precondition: candidate_created destination_availability_alpha (true), vehicle_allocated destination_availability_alpha (true), route_task_profile_available (true). Effect: candidate_task_profile_linked destination_availability_alpha route_task_profile_alpha, not route_task_profile_available.)
(Now destination has profile linked.)
(10. activate_destination_node destination_availability_alpha destination_node_alpha route_task_profile_alpha)
(Precondition: candidate_prepared destination_availability_alpha (true), candidate_task_profile_linked destination_availability_alpha route_task_profile_alpha (true), destination_availability_node_linked destination_availability_alpha destination_node_alpha (true), not destination_node_ready destination_node_alpha (true), not destination_node_occupied destination_node_alpha (true). Effect: destination_node_ready destination_node_alpha true.)
(11. load_destination_payload destination_availability_alpha destination_node_alpha cargo_payload_alpha)
(Precondition: candidate_prepared destination_availability_alpha (true), destination_availability_node_linked destination_availability_alpha destination_node_alpha (true), cargo_available cargo_payload_alpha (true), not destination_availability_locked destination_availability_alpha (true). Effect: destination_node_occupied destination_node_alpha true, destination_availability_locked destination_availability_alpha true, destination_payload_linked destination_availability_alpha cargo_payload_alpha true, not cargo_available cargo_payload_alpha.)
(Now cargo unavailable.)
(12. unload_destination_payload destination_availability_alpha destination_node_alpha route_task_profile_alpha cargo_payload_alpha)
(Precondition: candidate_prepared destination_availability_alpha (true), candidate_task_profile_linked destination_availability_alpha route_task_profile_alpha (true), destination_availability_node_linked destination_availability_alpha destination_node_alpha (true), destination_node_occupied destination_node_alpha (true), destination_payload_linked destination_availability_alpha cargo_payload_alpha true, not destination_availability_confirmed destination_availability_alpha (true). Effect: destination_node_ready destination_node_alpha true, destination_availability_confirmed destination_availability_alpha true, cargo_available cargo_payload_alpha true, not destination_payload_linked destination_availability_alpha cargo_payload_alpha.)
(Now cargo available again, destination_node_ready true, destination_availability_confirmed true, destination_availability_locked true (unchanged), destination_node_occupied true (unchanged), destination_payload_linked false.)
(Now both availabilities processed.)
(Now we need to assemble transport leg.)
(13. assemble_transport_leg origin_availability_alpha destination_availability_alpha origin_node_alpha destination_node_alpha transport_leg_alpha)
(Precondition: origin_availability_locked origin_availability_alpha (true), destination_availability_locked destination_availability_alpha (true), origin_availability_node_linked origin_availability_alpha origin_node_alpha (true), destination_availability_node_linked destination_availability_alpha destination_node_alpha (true), origin_node_ready origin_node_alpha (true), destination_node_ready destination_node_alpha (true), origin_availability_confirmed origin_availability_alpha (true), destination_availability_confirmed destination_availability_alpha (true), transport_leg_available transport_leg_alpha (true). Effect: transport_leg_assembled transport_leg_alpha true, transport_leg_origin_linked transport_leg_alpha origin_node_alpha true, transport_leg_destination_linked transport_leg_alpha destination_node_alpha true, not transport_leg_available transport_leg_alpha.)
(Now transport leg assembled, links set, transport_leg_available false.)
(14. attach_task_profile origin_availability_alpha route_task_profile_alpha)
(We need to link profile to origin for authorization. Currently profile is linked to destination (step 9). So we need to detach from destination first.)
(Thus before attaching to origin, we detach from destination.)
(14. detach_task_profile destination_availability_alpha route_task_profile_alpha)
(Precondition: candidate_task_profile_linked destination_availability_alpha route_task_profile_alpha (true). Effect: route_task_profile_available, not linked.)
(Now profile available.)
(15. attach_task_profile origin_availability_alpha route_task_profile_alpha)
(Precondition: candidate_created origin_availability_alpha (true), vehicle_allocated origin_availability_alpha (true), route_task_profile_available (true). Effect: candidate_task_profile_linked origin_availability_alpha route_task_profile_alpha, not route_task_profile_available.)
(Now origin has profile linked.)
(16. authorize_transport_leg_loading transport_leg_alpha origin_availability_alpha route_task_profile_alpha)
(Precondition: transport_leg_assembled transport_leg_alpha (true), origin_availability_locked origin_availability_alpha (true), candidate_task_profile_linked origin_availability_alpha route_task_profile_alpha (true), not transport_leg_loading_authorized transport_leg_alpha (true). Effect: transport_leg_loading_authorized transport_leg_alpha true.)
(Now loading authorized.)
(Now we need to mark origin and destination dispatch ready.)
(But note: mark_origin_availability_dispatch_ready requires origin_availability_locked, origin_availability_confirmed, transport_leg_assembled, transport_leg_loading_authorized, not dispatch_ready.)
(We have all.)
(17. mark_origin_availability_dispatch_ready origin_availability_alpha transport_leg_alpha)
(Precondition: origin_availability_locked origin_availability_alpha (true), origin_availability_confirmed origin_availability_alpha (true), transport_leg_assembled transport_leg_alpha (true), transport_leg_loading_authorized transport_leg_alpha (true), not dispatch_ready origin_availability_alpha (true). Effect: dispatch_ready origin_availability_alpha true.)
(18. mark_destination_availability_dispatch_ready destination_availability_alpha transport_leg_alpha)
(Precondition: destination_availability_locked destination_availability_alpha (true), destination_availability_confirmed destination_availability_alpha (true), transport_leg_assembled transport_leg_alpha (true), transport_leg_loading_authorized transport_leg_alpha (true), not dispatch_ready destination_availability_alpha (true). Effect: dispatch_ready destination_availability_alpha true.)
(Now we have both dispatch ready.)
(Now allocate dispatch slot for origin.)
(19. allocate_dispatch_slot_for_candidate origin_availability_alpha dispatch_slot_alpha route_task_profile_alpha)
(Precondition: dispatch_ready origin_availability_alpha (true), candidate_task_profile_linked origin_availability_alpha route_task_profile_alpha (true), dispatch_slot_available dispatch_slot_alpha (true after origin dispatch? Wait we haven't dispatched origin yet; slot is still available because we haven't allocated yet. Initially slot available)
