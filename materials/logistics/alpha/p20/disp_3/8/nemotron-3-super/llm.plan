    :effect
      (and
        (transport_leg_assembled ?transport_leg)
        (transport_leg_origin_linked ?transport_leg ?origin_node)
        (transport_leg_destination_linked ?transport_leg ?destination_node)
        (not
          (transport_leg_available ?transport_leg)
      )
    )

