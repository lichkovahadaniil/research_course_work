("stage_schedule_candidate": effect candidate_staged_for_loading.)
("reserve_equipment_resource": effect equipment_reserved, candidate_equipment_linked, not equipment_available.)
("confirm_equipment_assignment": effect candidate_staged_for_loading, equipment_confirmed.)
