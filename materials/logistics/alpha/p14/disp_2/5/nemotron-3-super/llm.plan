("create_candidate": effect candidate_created.)
("allocate_vehicle_unit": effect vehicle_allocated, candidate_vehicle_linked, not vehicle_available.)
("confirm_candidate_preparedness": effect candidate_prepared.)
("detach_task_profile": effect route_task_profile_available and not candidate_task_profile_linked.)
("assign_operator_resource": effect candidate_operator_linked, not operator_available.)
("release_operator_resource": effect operator_available, not candidate_operator_linked.)
("assign_skill_certificate": effect candidate_skill_certificate_linked, not skill_certificate_available.)
("release_skill_certificate": effect skill_certificate_available, not candidate_skill_certificate_linked.)
