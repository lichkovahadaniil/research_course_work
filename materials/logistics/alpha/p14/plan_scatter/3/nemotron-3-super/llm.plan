(Preconditions: transport_leg_assembled, origin_availability_locked, candidate_task_profile_linked origin_availability_alpha route_task_profile_alpha, not transport_leg_loading_authorized. All true.)
(Effect: transport_leg_loading_authorized.)
(9. Mark origin availability dispatch ready:)
(mark_origin_availability_dispatch_ready origin_availability_alpha transport_leg_alpha)
(Preconditions: origin_availability_locked, origin_availability_confirmed, transport_leg_assembled, transport_leg_loading_authorized, not dispatch_ready origin_availability_alpha. All true.)
(Effect: dispatch_ready origin_availability_alpha.)
(10. Mark destination availability dispatch ready:)
(mark_destination_availability_dispatch_ready destination_availability_alpha transport_leg_alpha)
(Preconditions: destination_availability_locked, destination_availability_confirmed, transport_leg_assembled, transport_leg_loading_authorized, not dispatch_ready destination_availability_alpha. All true.)
(Effect: dispatch_ready destination_availability_alpha.)
(11. Allocate dispatch slot to origin_availability_alpha:)
(allocate_dispatch_slot_for_candidate origin_availability_alpha dispatch_slot_alpha route_task_profile_alpha)
(Preconditions: dispatch_ready origin_availability_alpha (true), candidate_task_profile_linked origin_availability_alpha route_task_profile_alpha (true), dispatch_slot_available dispatch_slot_alpha (currently? We have not used dispatch slot yet; it's still allocated to shift_candidate_alpha initially, so not available. We need to free it first). So we need to make dispatch_slot_available before allocation. We'll dispatch shift_candidate_alpha earlier to free it.)
