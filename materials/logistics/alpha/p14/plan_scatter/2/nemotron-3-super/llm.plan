      origin_node_occupied: true (from load) and then unload does not change it -> still true.
      origin_node_ready: false (initially) -> load doesn't change it -> then unload sets it to true.
      origin_availability_locked: true (from load) and unload does not change it -> still true.
      origin_availability_confirmed: false (initially) -> load doesn't change it -> unload sets it to true.

