21. transport_leg_destination_linked transport_leg_alpha destination_node_alpha -> from assemble_transport_leg.

22. transport_leg_loading_authorized transport_leg_alpha -> from authorize_transport_leg_loading.

23. transport_leg_origin_linked transport_leg_alpha origin_node_alpha -> from assemble_transport_leg.

24. vehicle_available vehicle_unit_alpha -> from execute_origin_dispatch.

25. vehicle_available vehicle_unit_gamma -> from execute_schedule_dispatch.

