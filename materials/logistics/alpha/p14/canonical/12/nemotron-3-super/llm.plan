6. release_operator_resource origin_availability_alpha driver_operator_alpha   (free operator)
7. load_origin_payload origin_availability_alpha origin_node_alpha cargo_payload_alpha   (assuming requires locked)
8. detach_task_profile origin_availability_alpha route_task_profile_alpha
9. attach_task_profile destination_availability_alpha route_task_profile_alpha
10. confirm_candidate_preparedness destination_availability_alpha route_task_profile_alpha
