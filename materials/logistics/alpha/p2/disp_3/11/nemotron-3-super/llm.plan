   e6. assign_compliance_certificate shift_candidate_alpha compliance_certificate_alpha
   e7. load_container_onto_leg shift_candidate_alpha loading_container_alpha transport_leg_alpha
   e8. stage_schedule_candidate shift_candidate_alpha loading_container_alpha transport_leg_alpha route_task_profile_alpha
