finalize_candidate_direct:
precondition: (and (candidate_clearance_established ?candidate) (not (route_sequence_context_set ?candidate)) (not (candidate_finalized ?candidate)))
effect: (and (candidate_finalized ?candidate) (dispatch_ready ?candidate))

