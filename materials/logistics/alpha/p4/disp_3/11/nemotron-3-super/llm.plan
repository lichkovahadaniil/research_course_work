3. load_origin_payload origin_availability_alpha origin_node_alpha cargo_payload_alpha (need origin_availability_node_linked true, cargo_available true, not origin_availability_locked)
   After this, origin_availability_locked and confirmed true, origin_node_occupied true.
4. assign_operator_resource shift_candidate_beta driver_operator_alpha
5. assign_skill_certificate shift_candidate_beta skill_certificate_alpha
6. assign_compliance_certificate shift_candidate_beta compliance_certificate_alpha
7. allocate_vehicle_unit shift_candidate_beta vehicle_unit_gamma
8. attach_task_profile shift_candidate_beta route_task_profile_alpha
9. confirm_candidate_preparedness shift_candidate_beta route_task_profile_alpha
10. apply_operational_constraint shift_candidate_beta operational_constraint_beta route_task_profile_alpha (assuming available)
11. confirm_operator_alignment shift_candidate_beta driver_operator_alpha
12. verify_compliance_certificate shift_candidate_beta compliance_certificate_alpha
13. // Now we have compliance_validation_complete shift_candidate_beta
14. // Need to assemble transport leg: need origin_availability_locked (true), destination_availability_locked (true), origin_node_ready (true from step2), destination_node_ready (true from init), origin_node_occupied (true from step3), destination_node_occupied (true), transport_leg_available true.
   But assemble_transport_leg requires origin_node_ready and destination_node_ready, not occupied. However we have occupied; but preconditions do not forbid occupied. So we can still assemble? Precondition: origin_node_ready, destination_node_ready, origin_availability_confirmed, destination_availability_confirmed, transport_leg_available. It does not require not occupied. So we can proceed.
15. assemble_transport_leg origin_availability_alpha destination_availability_alpha origin_node_alpha destination_node_alpha transport_leg_alpha
16. authorize_transport_leg_loading transport_leg_alpha origin_availability_alpha route_task_profile_alpha (need origin_availability_locked true, candidate_task_profile_linked origin_availability_alpha route_task_profile_alpha true)
17. load_container_onto_leg shift_candidate_beta loading_container_beta transport_leg_alpha (need candidate_prepared true, candidate_transport_leg_linked true, candidate_loading_container_linked true, loading_container_available true (we have loading_container_beta available), transport_leg_assembled true, transport_leg_loading_authorized true)
   After this, loading_container_loaded true, loading_container_leg_linked true, loading_container_available false.
18. stage_schedule_candidate shift_candidate_beta loading_container_beta transport_leg_alpha route_task_profile_alpha (need candidate_prepared true, candidate_loading_container_linked true, loading_container_loaded true, loading_container_leg_linked true, candidate_task_profile_linked true, not origin_leg_loaded (true), not candidate_staged_for_loading true)
19. verify_loading_profile_nominal shift_candidate_beta skill_certificate_alpha driver_operator_alpha loading_container_beta transport_leg_alpha (need candidate_staged_for_loading true, skill cert linked, operator linked, loading container linked, loading_container_leg_linked true, not destination_leg_loaded (we haven't set destination_leg_loaded), not candidate_loading_verified)
20. // Now candidate_loading_verified true
21. establish_clearance_nominal shift_candidate_beta compliance_certificate_alpha loading_container_beta transport_leg_alpha (need candidate_loading_verified true, candidate_compliance_certificate_linked true, candidate_loading_container_linked true, loading_container_leg_linked true, not origin_leg_loaded, not destination_leg_loaded, not candidate_clearance_established)
   After this, candidate_clearance_established true, route_sequence_context_set true.
22. // Now we need dispatch ready for origin, destination, shift_candidate_beta.
   We need to make them dispatch_ready via mark_*_dispatch_ready actions.
   For origin: need origin_availability_locked (true), origin_availability_confirmed (true), transport_leg_assembled (true), transport_leg_loading_authorized (true), not dispatch_ready.
   So we can do mark_origin_availability_dispatch_ready origin_availability_alpha transport_leg_alpha
23. mark_destination_availability_dispatch_ready destination_availability_alpha transport_leg_alpha (need destination_availability_locked true, destination_availability_confirmed true, transport_leg_assembled true, transport_leg_loading_authorized true, not dispatch_ready)
24. mark_origin_availability_dispatch_ready? Wait we already did origin. Actually we need both origin and destination dispatch_ready.
   We'll do origin then destination.
25. mark_origin_availability_dispatch_ready origin_availability_alpha transport_leg_alpha
26. mark_destination_availability_dispatch_ready destination_availability_alpha transport_leg_alpha
27. // For shift_candidate_beta, we need dispatch_ready via finalize_candidate_after_compliance_validation? Actually we have compliance_validation_complete? We got via verify_compliance_certificate earlier. So we can do finalize_candidate_after_compliance_validation shift_candidate_beta (requires compliance_validation_complete, not candidate_finalized). Effect sets candidate_finalized and dispatch_ready.
28. finalize_candidate_after_compliance_validation shift_candidate_beta
29. // Now we have dispatch_ready for all three.
30. // Need to allocate dispatch slots to each candidate.
   allocate_dispatch_slot_for_candidate requires dispatch_ready ?candidate, candidate_task_profile_linked ?candidate ?route_task_profile, dispatch_slot_available ?dispatch_slot, not dispatch_allocated ?candidate.
   We have dispatch_slot_available initially true.
   We'll allocate to origin_availability_alpha first.
31. allocate_dispatch_slot_for_candidate origin_availability_alpha dispatch_slot_alpha route_task_profile_alpha (need dispatch_ready origin_availability_alpha true, candidate_task_profile_linked origin_availability_alpha route_task_profile_alpha true (we attached earlier), dispatch_slot_available true, not dispatch_allocated origin_availability_alpha)
   After this, dispatch_allocated origin_availability_alpha true, candidate_dispatch_slot_linked origin_availability_alpha dispatch_slot_alpha true, dispatch_slot_available false.
32. // Now we need to dispatch origin to make slot available again.
   execute_origin_dispatch origin_availability_alpha vehicle_unit_alpha dispatch_slot_alpha (precondition: dispatch_allocated origin_availability_alpha true, candidate_vehicle_linked origin_availability_alpha vehicle_unit_alpha true, candidate_dispatch_slot_linked origin_availability_alpha dispatch_slot_alpha true, not dispatched origin_availability_alpha)
   After effect: dispatched origin_availability_alpha true, vehicle_available vehicle_unit_alpha true, dispatch_slot_available true.
33. // Now allocate to destination_availability_alpha
   allocate_dispatch_slot_for_candidate destination_availability_alpha dispatch_slot_alpha route_task_profile_alpha (need dispatch_ready destination_availability_alpha true, candidate_task_profile_linked destination_availability_alpha route_task_profile_alpha true, dispatch_slot_available true, not dispatch_allocated destination_availability_alpha)
34. allocate_dispatch_slot_for_candidate destination_availability_alpha dispatch_slot_alpha route_task_profile_alpha
35. execute_destination_dispatch destination_availability_alpha vehicle_unit_beta dispatch_slot_alpha
36. // Now allocate to shift_candidate_beta
   allocate_dispatch_slot_for_candidate shift_candidate_beta dispatch_slot_alpha route_task_profile_alpha (need dispatch_ready shift_candidate_beta true, candidate_task_profile_linked shift_candidate_beta route_task_profile_alpha true, dispatch_slot_available true, not dispatch_allocated shift_candidate_beta)
37. allocate_dispatch_slot_for_candidate shift_candidate_beta dispatch_slot_alpha route_task_profile_alpha
38. execute_schedule_dispatch shift_candidate_beta vehicle_unit_gamma dispatch_slot_alpha
39. // Now we have dispatched all three, and vehicles available: origin vehicle_unit_alpha available (from step32), destination vehicle_unit_beta available (step35), shift_candidate_beta vehicle_unit_gamma allocated (so not available). Goal requires vehicle_available vehicle_unit_alpha and vehicle_unit_beta (true). Good.
40. // Also need vehicle_allocated shift_candidate_beta true (we allocated earlier step7). Good.
41. // Need candidate_vehicle_linked shift_candidate_beta vehicle_unit_gamma true (from step7).
42. // Need candidate_operator_linked shift_candidate_beta driver_operator_alpha true (step4).
43. // Need candidate_skill_certificate_linked shift_candidate_beta skill_certificate_alpha true (step5).
44. // Need candidate_compliance_certificate_linked shift_candidate_beta compliance_certificate_alpha true (step6).
45. // Need candidate_finalized shift_candidate_beta true (step28).
46. // Need candidate_loading_verified shift_candidate_beta true (step20).
47. // Need candidate_staged_for_loading shift_candidate_beta true (step18).
48. // Need loading_container_leg_linked loading_container_beta transport_leg_alpha true (step17 effect).
49. // Need loading_container_loaded loading_container_beta true (step17).
50. // Need origin_availability_confirmed origin_availability_alpha true (step3 effect).
51. // Need origin_availability_locked origin_availability_alpha true (step3).
52. // Need origin_node_occupied origin_node_alpha true (step3).
53. // Need origin_node_ready origin_node_alpha true (step2).
54. // Need destination_node_occupied destination_node_alpha true (init).
55. // Need destination_node_ready destination_node_alpha true (init).
56. // Need transport_leg_assembled transport_leg_alpha true (step15).
57. // Need transport_leg_destination_linked transport_leg_alpha destination_node_alpha true (step15).
58. // Need transport_leg_origin_linked transport_leg_alpha origin_node_alpha true (step15).
59. // Need transport_leg_loading_authorized transport_leg_alpha true (step16).
60. // Need dispatch_allocated destination_availability_alpha true (step34).
61. // Need dispatch_allocated origin_availability_alpha true (step31).
62. // Need dispatch_allocated shift_candidate_beta true (step37).
63. // Need dispatch_ready destination_availability_alpha true (step26).
64. // Need dispatch_ready origin_availability_alpha true (step25).
65. // Need dispatch_ready shift_candidate_beta true (step28).
66. // Need dispatched destination_availability_alpha true (step35).
67. // Need dispatched origin_availability_alpha true (step32).
68. // Need dispatched shift_candidate_beta true (step38).
69. // Need candidate_prepared origin_availability_alpha true (init).
70. // Need candidate_prepared shift_candidate_beta true (step9).
71. // Need candidate_task_profile_linked shift_candidate_beta route_task_profile_alpha true (step8).
72. // Need candidate_vehicle_linked shift_candidate_beta vehicle_unit_gamma true (step7).
73. // Need candidate_dispatch