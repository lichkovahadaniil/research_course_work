(Now step by step.)
(1. create_candidate origin_availability_alpha:)
(pre: not candidate_created ?candidate, not dispatched ?candidate. Both true.)
(effect: candidate_created origin_availability_alpha.)
(2. create_candidate destination_availability_alpha: similar.)
(3. create_candidate shift_candidate_alpha: similar.)
(4. create_candidate shift_candidate_beta: similar.)
(Now we have candidate_created for all four.)
(5. allocate_vehicle_unit origin_availability_alpha vehicle_unit_alpha:)
(pre: candidate_created origin_availability_alpha, not vehicle_allocated origin_availability_alpha, vehicle_available vehicle_unit_alpha.)
(vehicle_available true.)
(effect: vehicle_allocated origin_availability_alpha true, candidate_vehicle_linked origin_availability_alpha vehicle_unit_alpha true, vehicle_available vehicle_unit_alpha false.)
(6. allocate_vehicle_unit destination_availability_alpha vehicle_unit_beta:)
(pre: candidate_created destination_availability_alpha, not vehicle_allocated destination_availability_alpha, vehicle_available vehicle_unit_beta (still true).)
(effect: vehicle_allocated destination_availability_alpha true, candidate_vehicle_linked destination_availability_alpha vehicle_unit_beta true, vehicle_available vehicle_unit_beta false.)
(7. allocate_vehicle_unit shift_candidate_alpha vehicle_unit_gamma:)
(pre: candidate_created shift_candidate_alpha, not vehicle_allocated shift_candidate_alpha, vehicle_available vehicle_unit_gamma (still true).)
(effect: vehicle_allocated shift_candidate_alpha true, candidate_vehicle_linked shift_candidate_alpha vehicle_unit_gamma true, vehicle_available vehicle_unit_gamma false.)
(Now vehicles allocated.)
(8. attach_task_profile origin_availability_alpha route_task_profile_alpha:)
(pre: candidate_created origin_availability_alpha, vehicle_allocated origin_availability_alpha, route_task_profile_available route_task_profile_alpha (true).)
(effect: candidate_task_profile_linked origin_availability_alpha route_task_profile_alpha true, route_task_profile_available false.)
(9. confirm_candidate_preparedness origin_availability_alpha route_task_profile_alpha:)
(pre: candidate_created origin_availability_alpha, vehicle_allocated origin_availability_alpha, candidate_task_profile_linked origin_availability_alpha route_task_profile_alpha, not candidate_prepared origin_availability_alpha.)
(effect: candidate_prepared origin_availability_alpha true.)
(10. activate_origin_node origin_availability_alpha origin_node_alpha route_task_profile_alpha:)
(pre: candidate_prepared origin_availability_alpha, candidate_task_profile_linked origin_availability_alpha route_task_profile_alpha, origin_availability_node_linked origin_availability_alpha origin_node_alpha (true from init), not origin_node_ready origin_node_alpha (true), not origin_node_occupied origin_node_alpha (true).)
(effect: origin_node_ready origin_node_alpha true.)
(Now we still have origin_availability_alpha task profile linked.)
(11. assign_operator_resource origin_availability_alpha driver_operator_alpha:)
(pre: candidate_prepared origin_availability_alpha, operator_available driver_operator_alpha (true).)
(effect: candidate_operator_linked origin_availability_alpha driver_operator_alpha true, operator_available driver_operator_alpha false.)
(12. lock_origin_availability origin_availability_alpha origin_node_alpha driver_operator_alpha:)
(pre: candidate_prepared origin_availability_alpha, candidate_operator_linked origin_availability_alpha driver_operator_alpha, origin_availability_node_linked origin_availability_alpha origin_node_alpha, origin_node_ready origin_node_alpha, not origin_availability_locked origin_availability_alpha.)
(effect: origin_availability_locked origin_availability_alpha true, origin_availability_confirmed origin_availability_alpha true.)
