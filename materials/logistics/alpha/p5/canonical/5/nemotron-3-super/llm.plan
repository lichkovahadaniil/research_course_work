(Let's write out the plan stepwise with tracking.)
(We'll use abbreviations but output full PDDL action calls.)
(Let's define constants:)
(- scA = shift_candidate_alpha)
(- scB = shift_candidate_beta)
(- oaA = origin_availability_alpha)
(- daA = destination_availability_alpha)
(- vA = vehicle_unit_alpha)
(- vB = vehicle_unit_beta)
(- vC = vehicle_unit_gamma)
(- rtp = route_task_profile_alpha)
(- op = driver_operator_alpha)
(- cargo = cargo_payload_alpha)
(- tl = transport_leg_alpha)
(- lcA = loading_container_alpha)
(- lcB = loading_container_beta)
(- eqA = equipment_resource_alpha)
(- eqB = equipment_resource_beta)
(- swA = service_window_alpha)
(- swB = service_window_beta)
(- ds = dispatch_slot_alpha)
(- sc = skill_certificate_alpha)
(- cc = compliance_certificate_alpha)
(- ocA = operational_constraint_alpha)
(- ocB = operational_constraint_beta)
(Now steps:)
(1. (create_candidate scA))
(2. (create_candidate scB))
(3. (create_candidate oaA))
(4. (create_candidate daA))
(5. (allocate_vehicle_unit scA vA))
(6. (allocate_vehicle_unit oaA vB))
(7. (allocate_vehicle_unit daA vC))
(Now we need to attach task profile to oaA first.)
(8. (attach_task_profile oaA rtp))
(Pre: candidate_created oaA (true), vehicle_allocated oaA (true after step6), route_task_profile_available rtp (still true because we haven't used it yet). Good.)
(Effect: candidate_task_profile_linked oaA rtp, not route_task_profile_available rtp.)
(Now we need to confirm prepared for oaA.)
(9. (confirm_candidate_preparedness oaA rtp))
(Pre: candidate_created oaA, vehicle_allocated oaA, candidate_task_profile_linked oaA rtp, not candidate_prepared oaA. True.)
(Effect: candidate_prepared oaA.)
(Now assign operator to oaA.)
(10. (assign_operator_resource oaA op))
(Pre: candidate_prepared oaA, operator_available op. True (operator still available).)
(Effect: candidate_operator_linked oaA op, not operator_available op.)
(Now activate origin node.)
(11. (activate_origin_node oaA origin_node_alpha rtp))
(Pre: candidate_prepared oaA, candidate_task_profile_linked oaA rtp, origin_availability_node_linked oaA origin_node_alpha, not origin_node_ready origin_node_alpha, not origin_node_occupied origin_node_alpha.)
(We have origin_availability_node_linked oaA origin_node_alpha from init. origin_node_ready? Not set yet. origin_node_occupied? Not set. So preconditions satisfied.)
(Effect: origin_node_ready origin_node_alpha.)
(Now lock origin availability.)
(12. (lock_origin_availability oaA origin_node_alpha op))
(Pre: candidate_prepared oaA, candidate_operator_linked oaA op, origin_availability_node_linked oaA origin_node_alpha, origin_node_ready origin_node_alpha, not origin_availability_locked oaA.)
(All true.)
(Effect: origin_availability_locked oaA, origin_availability_confirmed oaA.)
(Now release operator from oaA.)
(13. (release_operator_resource oaA op))
(Pre: candidate_operator_linked oaA op.)
(Effect: operator_available op, not candidate_operator_linked oaA op.)
(Now we have operator available again.)
(Now detach task profile from oaA to free for daA.)
(14. (detach_task_profile oaA rtp))
(Pre: candidate_task_profile_linked oaA rtp.)
(Effect: route_task_profile_available rtp, not candidate_task_profile_linked oaA rtp.)
(Now process daA similarly.)
(15. (attach_task_profile daA rtp))
(Pre: candidate_created daA, vehicle_allocated daA, route_task_profile_available rtp (now true after detach), good.)
(Effect: candidate_task_profile_linked daA rtp, not route_task_profile_available rtp.)
(16. (confirm_candidate_preparedness daA rtp))
(Pre: candidate_created daA, vehicle_allocated daA, candidate_task_profile_linked daA rtp, not candidate_prepared daA.)
(Effect: candidate_prepared daA.)
(17. (assign_operator_resource daA op))
(Pre: candidate_prepared daA, operator_available op (true after release).)
(Effect: candidate_operator_linked daA op, not operator_available op.)
(18. (activate_destination_node daA destination_node_alpha rtp))
(Pre: candidate_prepared daA, candidate_task_profile_linked daA rtp, destination_availability_node_linked daA destination_node_alpha, not destination_node_ready destination_node_alpha, not destination_node_occupied destination_node_alpha.)
(Effect: destination_node_ready destination_node_alpha.)
(19. (lock_destination_availability daA destination_node_alpha op))
(Pre: candidate_prepared daA, candidate_operator_linked daA op, destination_availability_node_linked daA destination_node_alpha, destination_node_ready destination_node_alpha, not destination_availability_locked daA.)
(Effect: destination_availability_locked daA, destination_availability_confirmed daA.)
(20. (release_operator_resource daA op))
(Pre: candidate_operator_linked daA op.)
(Effect: operator_available op, not candidate_operator_linked daA op.)
(Now detach task profile from daA to free for scA.)
(21. (detach_task_profile daA rtp))
(Pre: candidate_task_profile_linked daA rtp.)
(Effect: route_task_profile_available rtp, not candidate_task_profile_linked daA rtp.)
(Now we have oaA and daA locked and confirmed, operator free.)
(Now process scA: attach task profile.)
(22. (attach_task_profile scA rtp))
(Pre: candidate_created scA, vehicle_allocated scA, route_task_profile_available rtp (now true), good.)
(Effect: candidate_task_profile_linked scA rtp, not route_task_profile_available rtp.)
(23. (confirm_candidate_preparedness scA rtp))
(Pre: candidate_created scA, vehicle_allocated scA, candidate_task_profile_linked scA rtp, not candidate_prepared scA.)
(Effect: candidate_prepared scA.)
(Now assign operator to scA (we will keep it for later steps).)
(24. (assign_operator_resource scA op))
(Pre: candidate_prepared scA, operator_available op (true).)
(Effect: candidate_operator_linked scA op, not operator_available op.)
(Now assign skill certificate to scA.)
(25. (assign_skill_certificate scA sc))
(Pre: candidate_prepared scA, skill_certificate_available sc.)
(Effect: candidate_skill_certificate_linked scA sc, not skill_certificate_available sc.)
(Assign compliance certificate to scA.)
(26. (assign_compliance_certificate scA cc))
(Pre: candidate_prepared scA, compliance_certificate_available cc.)
(Effect: candidate_compliance_certificate_linked scA cc, not compliance_certificate_available cc.)
(Apply operational constraint to scA.)
(27. (apply_operational_constraint scA ocA r)
